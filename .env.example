# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform browser key (provisioned in AI Studio or restricted HTTP referrer key)
VITE_GOOGLE_MAPS_API_KEY=

# Session signing secret (optional; falls back to runtime random secret if unset)
SESSION_SECRET=

# Optional Admin Passcode for direct owner access to /admin
ADMIN_PASSCODE=

# Razorpay Payment Gateway credentials (optional in preview; enables live Razorpay Orders & HMAC verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Supabase / PostgreSQL credentials for production deployment
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
